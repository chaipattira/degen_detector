#!/bin/bash
#SBATCH --job-name=camels-detect         # Job name
#SBATCH --nodes=1                        # Number of nodes
#SBATCH --ntasks=1                       # Number of tasks
#SBATCH --cpus-per-task=8               # CPUs per task
#SBATCH --time=04:00:00                 # Time limit
#SBATCH --partition=shared              # CPU shared partition
#SBATCH --account=phy240043             # Account name
#SBATCH --array=0-5                     # 6 tasks: 3 fields × 2 log_mode values
#SBATCH --output=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out
#SBATCH --error=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out

# Task ID → (field, mode) mapping:
# 0: Mcdm/linear   1: Mcdm/log
# 2: Mgas/linear   3: Mgas/log
# 4: Mstar/linear  5: Mstar/log
FIELDS=(Mcdm Mcdm Mgas Mgas Mstar Mstar)
LOG_FLAGS=("" "--log-mode" "" "--log-mode" "" "--log-mode")

FIELD=${FIELDS[$SLURM_ARRAY_TASK_ID]}
LOG_FLAG=${LOG_FLAGS[$SLURM_ARRAY_TASK_ID]}

DATA_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/data/camels_sb28"
REPRODUCE_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/reproduce"
PROJECT_DIR="/home/x-ctirapongpra/scratch/degen_detector"
OUT_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/outputs/reproduce/camels_sb28"

module load gcc/14.2.0
module load julia/1.11.4
export PYTHON_JULIAPKG_EXE=$(which julia)

echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Field:  ${FIELD}, log_mode flag: '${LOG_FLAG}'"
echo "Node:   $(hostname)"
echo "Start:  $(date)"

uv run --project "${PROJECT_DIR}" python "${REPRODUCE_DIR}/run_camels_sb28.py" \
    --field "${FIELD}" \
    --params-file "${DATA_DIR}/params_SB28_IllustrisTNG.txt" \
    --out-dir "${OUT_DIR}" \
    --n-samples 20000 \
    --coupling-depth 2 \
    --max-fits 5 \
    --niterations 200 \
    ${LOG_FLAG}

echo "${FIELD} (log_mode=${LOG_FLAG:-false}) detection complete"
echo "End: $(date)"
