#!/bin/bash
#SBATCH --job-name=camels-detect         # Job name
#SBATCH --nodes=1                        # Number of nodes
#SBATCH --ntasks=1                       # Number of tasks
#SBATCH --cpus-per-task=8               # CPUs per task
#SBATCH --time=02:00:00                 # Time limit (longer for depth 5-6)
#SBATCH --partition=shared              # CPU shared partition
#SBATCH --account=phy240043             # Account name
#SBATCH --array=0-29                    # 30 tasks: 3 fields × 2 modes × 5 depths (2-6)
#SBATCH --output=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out
#SBATCH --error=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out

# Task ID layout (depth cycles fastest):
#  0- 4: Mcdm/linear/depth  2,3,4,5,6
#  5- 9: Mcdm/log/depth     2,3,4,5,6
# 10-14: Mgas/linear/depth  2,3,4,5,6
# 15-19: Mgas/log/depth     2,3,4,5,6
# 20-24: Mstar/linear/depth 2,3,4,5,6
# 25-29: Mstar/log/depth    2,3,4,5,6

FIELDS=(Mcdm Mgas Mstar)
FIELD_IDX=$(( SLURM_ARRAY_TASK_ID / 10 ))
MODE_IDX=$(( (SLURM_ARRAY_TASK_ID % 10) / 5 ))
DEPTH_IDX=$(( SLURM_ARRAY_TASK_ID % 5 ))

FIELD=${FIELDS[$FIELD_IDX]}
COUPLING_DEPTH=$(( DEPTH_IDX + 2 ))           # 2,3,4,5,6
MODE_FLAG=$( [ "$MODE_IDX" -eq 0 ] && echo "--linear-only" || echo "--log-mode" )

CAMELS_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/reproduce/camels"
PROJECT_DIR="/home/x-ctirapongpra/scratch/degen_detector"
OUT_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/outputs/reproduce/camels_sb28"

module load gcc/14.2.0
module load julia/1.11.4
export PYTHON_JULIAPKG_EXE=$(which julia)

echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Field:  ${FIELD}, mode: ${MODE_FLAG}, coupling_depth: ${COUPLING_DEPTH}"
echo "Node:   $(hostname)"
echo "Start:  $(date)"

uv run --project "${PROJECT_DIR}" python "${CAMELS_DIR}/detect.py" \
    --field "${FIELD}" \
    --out-dir "${OUT_DIR}" \
    --coupling-depth "${COUPLING_DEPTH}" \
    --max-fits 5 \
    --niterations 200 \
    ${MODE_FLAG}

echo "${FIELD} depth=${COUPLING_DEPTH} ${MODE_FLAG} detection complete"
echo "End: $(date)"
