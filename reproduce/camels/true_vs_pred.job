#!/bin/bash
#SBATCH --job-name=tvp-sample             # Job name
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=8
#SBATCH --mem=32G                         # mmap maps + posterior + samples
#SBATCH --time=4:00:00
#SBATCH --partition=shared
#SBATCH --account=phy240043
#SBATCH --qos=cpu
#SBATCH --array=0-2                       # 0:Mcdm  1:Mgas  2:Mstar
#SBATCH --output=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out
#SBATCH --error=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out

FIELDS=(Mcdm Mgas Mstar)
FIELD=${FIELDS[$SLURM_ARRAY_TASK_ID]}

PROJECT_DIR="/home/x-ctirapongpra/scratch/degen_detector"
SCRIPT="${PROJECT_DIR}/reproduce/science/camels_sb28/fig_true_vs_pred.py"
FIGURES_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/figures"

module load gcc/14.2.0
module load julia/1.11.4
export PYTHON_JULIAPKG_EXE=$(which julia)

echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Field:  ${FIELD}"
echo "Node:   $(hostname)"
echo "Start:  $(date)"

uv run --project "${PROJECT_DIR}" python "${SCRIPT}" \
    --field "${FIELD}" \
    --mode log \
    --depths 2 3 4 \
    --use-cache \
    --n-test 50 \
    --n-samples 2000 \
    --device cpu \
    --out-dir "${FIGURES_DIR}"

echo "${FIELD} done"
echo "End: $(date)"
