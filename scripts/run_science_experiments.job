#!/bin/bash
#SBATCH --job-name=degen-science   # Job name
#SBATCH --nodes=1                  # Number of nodes
#SBATCH --ntasks=1                 # Number of tasks
#SBATCH --cpus-per-task=8          # CPUs per experiment
#SBATCH --time=02:00:00            # Time limit (2 hours)
#SBATCH --partition=shared         # Partition name
#SBATCH --account=phy240043        # Account name
#SBATCH --array=0-2                # Array range for 3 experiments (planck, desi, des_y3)
#SBATCH --output=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out  # Output file
#SBATCH --error=/anvil/scratch/x-ctirapongpra/jobout/%x_%A_%a.out   # Error file

# Load conda environment
cd /home/x-ctirapongpra/scratch/
module load anaconda
conda activate degen_detector

# Array of experiments
EXPERIMENTS=(
    "planck"
    "desi"
    "des_y3"
)

# Select experiment based on array task ID
EXP=${EXPERIMENTS[$SLURM_ARRAY_TASK_ID]}

# Print job information
echo "Job ID: ${SLURM_ARRAY_JOB_ID}_${SLURM_ARRAY_TASK_ID}"
echo "Experiment: ${EXP}"
echo "Node: $(hostname)"
echo "Start time: $(date)"

# Run the experiment
if [ "${EXP}" == "planck" ]; then
    OUTPUT_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/outputs/planck_logmode"
    echo "Output directory: ${OUTPUT_DIR}"
    python /home/x-ctirapongpra/scratch/degen_detector/scripts/run_planck_logmode.py \
        --output-dir ${OUTPUT_DIR}
elif [ "${EXP}" == "desi" ]; then
    OUTPUT_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/outputs/desi_dr1_logmode"
    echo "Output directory: ${OUTPUT_DIR}"
    python /home/x-ctirapongpra/scratch/degen_detector/scripts/run_desi_logmode.py \
        --output-dir ${OUTPUT_DIR}
elif [ "${EXP}" == "des_y3" ]; then
    OUTPUT_DIR="/anvil/scratch/x-ctirapongpra/degen_detector/outputs/des_y3_logmode"
    echo "Output directory: ${OUTPUT_DIR}"
    python /home/x-ctirapongpra/scratch/degen_detector/scripts/run_des_y3_logmode.py \
        --output-dir ${OUTPUT_DIR}
fi

# Print completion info
echo "Experiment ${EXP} completed"
echo "End time: $(date)"
